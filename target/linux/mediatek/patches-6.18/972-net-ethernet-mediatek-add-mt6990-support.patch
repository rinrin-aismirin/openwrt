 	MTK_CLK_TOP_NETSYS_SYNC_250M_SEL,
 	MTK_CLK_TOP_NETSYS_PPEFB_250M_SEL,
 	MTK_CLK_TOP_NETSYS_WARP_SEL,
+	MTK_CLK_SGMII_0_SEL,
+	MTK_CLK_SGMII_SBUS_0_SEL,
+	MTK_CLK_SGMII_1_SEL,
