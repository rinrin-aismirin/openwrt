From: Rinrin <rinrin@aismir.in>
Subject: [PATCH] leds: add driver for the Awinic AW9523B in LED mode

The AW9523B is an I2C port expander whose pins can also sink a constant
current with 256 dimming steps. Add a driver for that LED mode; it is used
for the front-panel LEDs of the SoftBank Air 6.

The driver source lives in files/drivers/leds/leds-aw9523b.c.
---
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -1038,6 +1038,17 @@
 	  To compile this driver as a module, choose M here: the module
 	  will be called leds-smartrg-system.
 
+config LEDS_AW9523B
+	tristate "LED support for the Awinic AW9523B in LED mode"
+	depends on LEDS_CLASS && I2C && OF
+	select REGMAP_I2C
+	help
+	  This option enables support for the Awinic AW9523B I2C port
+	  expander used as a 16-channel constant-current LED driver.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called leds-aw9523b.
+
 comment "LED Triggers"
 source "drivers/leds/trigger/Kconfig"
 
--- a/drivers/leds/Makefile
+++ b/drivers/leds/Makefile
@@ -86,6 +86,7 @@
 obj-$(CONFIG_LEDS_REGULATOR)		+= leds-regulator.o
 obj-$(CONFIG_LEDS_SC27XX_BLTC)		+= leds-sc27xx-bltc.o
 obj-$(CONFIG_LEDS_SMARTRG_LED)		+= leds-smartrg-system.o
+obj-$(CONFIG_LEDS_AW9523B)		+= leds-aw9523b.o
 obj-$(CONFIG_LEDS_ST1202)		+= leds-st1202.o
 obj-$(CONFIG_LEDS_SUN50I_A100)		+= leds-sun50i-a100.o
 obj-$(CONFIG_LEDS_SUNFIRE)		+= leds-sunfire.o
