#!/bin/sh
# A/B guard for SoftBank Air 6 bring-up builds.
#
# The stock preloader only counts boot attempts on warm resets (a power cut clears the counter flag), so an
# image that boots but is unreachable would never fall back by itself. While the booted slot is not marked
# successful, `arm` makes the other (successful) slot preferred and reboots after a timeout unless `confirm`
# is run first.
#
#   air6-abguard status            print booted slot and boot control bytes
#   air6-abguard arm [seconds]     (boot) schedule the revert if the booted slot is unsuccessful (default 600)
#   air6-abguard confirm           cancel the scheduled revert for this boot only
#   air6-abguard commit            mark the booted slot successful and reset its retry count (stock semantics)
#   air6-abguard revert            make the other slot preferred now (no reboot)
#
# Boot control layout (stock /lib/upgrade/bootctrl.sh): misc+2048, magic "BCAB" at +4,
# slot A prio/retry/success/uptype at +12..+15, slot B at +17..+20.

. /lib/functions.sh

BASE=2048
CONFIRMED=/tmp/air6-abguard.confirmed
TAG=air6-abguard

log() { logger -t "$TAG" "$*"; echo "$*"; }
die() { log "error: $*"; exit 1; }

misc_dev() {
	local p
	p="$(find_mmc_part misc)"
	[ -b "$p" ] || die "misc partition not found"
	echo "$p"
}

rd() { dd if="$MISC" bs=1 skip=$(($BASE + $1)) count=1 2>/dev/null | hexdump -v -e '1/1 "%02x"'; }

wr() {
	printf "\\$(printf '%03o' "0x$2")" | dd of="$MISC" bs=1 seek=$(($BASE + $1)) count=1 conv=notrunc 2>/dev/null
	[ "$(rd "$1")" = "$2" ] || die "write verify failed at +$1"
}

slot_off() { [ "$1" = a ] && echo 12 || echo 17; }   # prio offset; retry +1, success +2, uptype +3

init() {
	[ "$(board_name)" = "softbank,air6" ] || die "not a SoftBank Air 6"
	MISC="$(misc_dev)"
	[ "$(dd if="$MISC" bs=1 skip=$(($BASE + 4)) count=4 2>/dev/null)" = "BCAB" ] || die "boot control magic missing"
	CUR="$(sed -n 's/.*bootslot=\([ab]\).*/\1/p' /proc/cmdline)"
	[ -n "$CUR" ] || die "bootslot not on the kernel command line"
	[ "$CUR" = a ] && OTHER=b || OTHER=a
	C=$(slot_off "$CUR"); O=$(slot_off "$OTHER")
}

status() {
	echo "booted=$CUR"
	for s in a b; do
		o=$(slot_off $s)
		echo "slot $s: prio=$(rd $o) retry=$(rd $((o + 1))) success=$(rd $((o + 2))) uptype=$(rd $((o + 3)))"
	done
}

revert() {
	[ "$(rd $((O + 2)))" = 01 ] || die "slot $OTHER is not marked successful; not switching to it"
	wr "$O" 0f
	wr "$C" 0e
	sync
	log "slot $OTHER made preferred (slot $CUR prio 0e)"
}

arm() {
	local t="${1:-600}"
	if [ "$(rd $((C + 2)))" = 01 ]; then
		log "slot $CUR is committed; guard not armed"
		return 0
	fi
	if [ "$(rd $((O + 2)))" != 01 ]; then
		log "slot $OTHER is not successful; guard not armed"
		return 0
	fi
	rm -f "$CONFIRMED"
	log "slot $CUR is not committed; reverting to slot $OTHER in ${t}s unless '$0 confirm' runs"
	(
		sleep "$t"
		[ -e "$CONFIRMED" ] && exit 0
		log "not confirmed within ${t}s: reverting to slot $OTHER and rebooting"
		revert && reboot
	) >/dev/null 2>&1 </dev/null &
}

cmd="$1"; shift
init
case "$cmd" in
	status) status ;;
	arm) arm "$@" ;;
	confirm) touch "$CONFIRMED"; log "revert cancelled for this boot" ;;
	commit) wr $((C + 1)) 00; wr $((C + 2)) 01; sync; log "slot $CUR committed" ;;
	revert) revert ;;
	*) echo "usage: $0 status|arm [seconds]|confirm|commit|revert" >&2; exit 2 ;;
esac
