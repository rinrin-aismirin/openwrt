// SPDX-License-Identifier: GPL-2.0-only
/*
 * MediaTek MT6990 (T830) SoC
 *
 * Written from the device tree the SoftBank Air 6 stock firmware boots with. It
 * describes the blocks that drivers in this tree use, the nodes those refer to,
 * and the nodes the bootloader (LK) fills in at boot.
 */

#include <dt-bindings/clock/mt6990-clk.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/power/mt6990-power.h>
#include <dt-bindings/reset/ti-syscon.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "mediatek,mt6990";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	/*
	 * Devices sit directly under the root, without a "soc" simple-bus: LK patches
	 * several nodes by absolute path, so every path of the stock tree is kept.
	 */

	clocks {
		clk26m: clk26m {
			compatible = "fixed-clock";
			clock-frequency = <26000000>;
			#clock-cells = <0>;
		};

		clk13m: clk13m {
			compatible = "fixed-clock";
			clock-frequency = <13000000>;
			#clock-cells = <0>;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a55";
			reg = <0>;
			device_type = "cpu";
			enable-method = "psci";
			clock-frequency = <1701000000>;
			cpu-idle-states = <&cpu_off_l>, <&cluster_off_l>, <&mcusys_off>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@100 {
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			device_type = "cpu";
			enable-method = "psci";
			clock-frequency = <1701000000>;
			cpu-idle-states = <&cpu_off_l>, <&cluster_off_l>, <&mcusys_off>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@200 {
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			device_type = "cpu";
			enable-method = "psci";
			clock-frequency = <1701000000>;
			cpu-idle-states = <&cpu_off_l>, <&cluster_off_l>, <&mcusys_off>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@300 {
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			device_type = "cpu";
			enable-method = "psci";
			clock-frequency = <1701000000>;
			cpu-idle-states = <&cpu_off_l>, <&cluster_off_l>, <&mcusys_off>;
			#cooling-cells = <2>;
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpu_off_l: cpu-off-l {
				compatible = "arm,idle-state";
				local-timer-stop;
				entry-latency-us = <50>;
				exit-latency-us = <100>;
				min-residency-us = <1600>;
				arm,psci-suspend-param = <0x10001>;
			};

			cluster_off_l: cluster-off-l {
				compatible = "arm,idle-state";
				local-timer-stop;
				entry-latency-us = <100>;
				exit-latency-us = <250>;
				min-residency-us = <2100>;
				arm,psci-suspend-param = <0x1010001>;
			};

			mcusys_off: mcusys-off {
				compatible = "arm,idle-state";
				local-timer-stop;
				entry-latency-us = <450>;
				exit-latency-us = <600>;
				min-residency-us = <4000>;
				arm,psci-suspend-param = <0x1010002>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved_memory: reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;

		gps_reserve_memory: gps-reserve-memory {
			compatible = "mediatek,gps-reserve-memory";
			no-map;
			size = <0 0x60000>;
			alignment = <0 0x10000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		wocpu0_emi: wocpu0-emi@a1be0000 {
			compatible = "mediatek,wocpu0_emi";
			reg = <0 0xa1be0000 0 0x40000>;
			no-map;
			shared = <0>;
		};

		wocpu1_emi: wocpu1-emi@a1c20000 {
			compatible = "mediatek,wocpu1_emi";
			reg = <0 0xa1c20000 0 0x40000>;
			no-map;
			shared = <0>;
		};

		wocpu2_emi: wocpu2-emi@a1c60000 {
			compatible = "mediatek,wocpu2_emi";
			reg = <0 0xa1c60000 0 0x40000>;
			no-map;
			shared = <0>;
		};

		wocpu-data@a30a0000 {
			compatible = "mediatek,wocpu_data";
			reg = <0 0xa30a0000 0 0xf00000>;
			no-map;
			shared = <1>;
		};
	};

	thermal-zones {
		soc-max-thermal {
			polling-delay = <100>;
			polling-delay-passive = <50>;
			thermal-sensors = <&lvts 0>;

			trips {
				soc_max_cpu_alert: cpu-alert {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_max_crit: soc-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&soc_max_cpu_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					                 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};

		cpu-little0-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 1>;
		};

		cpu-little1-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 2>;
		};

		cpu-little2-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 3>;
		};

		cpu-little3-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 4>;
		};

		gpu0-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 5>;
		};

		gpu1-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 6>;
		};

		infra-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 7>;
		};

		connsys-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 8>;
		};

		md0-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 9>;
		};

		md1-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 10>;
		};

		md2-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 11>;
		};

		md3-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 12>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <13000000>;
	};

	gic: interrupt-controller@c000000 {
		compatible = "arm,gic-v3";
		reg = <0 0xc000000 0 0x40000>, <0 0xc040000 0 0x200000>;
		interrupt-parent = <&gic>;
		interrupt-controller;
		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		#interrupt-cells = <3>;
		#address-cells = <2>;
		#size-cells = <2>;
		#redistributor-regions = <1>;
	};

	topckgen: syscon@10000000 {
		compatible = "mediatek,mt6990-topckgen", "syscon";
		reg = <0 0x10000000 0 0x1000>;
		#clock-cells = <1>;
		mediatek,hardware-voter = <&hwv>;
	};

	infracfg_ao: syscon@10001000 {
		compatible = "mediatek,mt6990-infracfg_ao", "syscon";
		reg = <0 0x10001000 0 0x1000>;
		#clock-cells = <1>;
	};

	pio: pinctrl@10004000 {
		compatible = "mediatek,mt69xx-pinctrl";
		reg = <0 0x10004000 0 0x1000>,
		      <0 0x11c00000 0 0x1000>,
		      <0 0x11c10000 0 0x1000>,
		      <0 0x11d00000 0 0x1000>,
		      <0 0x11d10000 0 0x1000>,
		      <0 0x11d20000 0 0x1000>,
		      <0 0x11d30000 0 0x1000>,
		      <0 0x11e80000 0 0x1000>,
		      <0 0x11e90000 0 0x1000>,
		      <0 0x11eb0000 0 0x1000>;
		reg-names = "gpio",
		            "iocfg_rt_8",
		            "iocfg_rt_9",
		            "iocfg_bm_4",
		            "iocfg_bm_5",
		            "iocfg_bm_6",
		            "iocfg_bm_7",
		            "iocfg_lt_0",
		            "iocfg_lt_1",
		            "iocfg_lt_3";
		gpio-controller;
		gpio-ranges = <&pio 0 0 0xe2>;
		interrupt-controller;
		#gpio-cells = <2>;
		#interrupt-cells = <2>;
		mediatek,eint = <&eint>;
	};

	apmixedsys: syscon@10010000 {
		compatible = "mediatek,mt6990-apmixedsys", "syscon";
		reg = <0 0x10010000 0 0xe00>;
		#clock-cells = <1>;
	};

	sgmii_pll: syscon@10014000 {
		compatible = "mediatek,colgin-sgmiisys_pll", "syscon";
		reg = <0 0x10014000 0 0x1000>;
	};

	pcie-mirror@10201000 {
		compatible = "mediatek,pcie-mirror";
		reg = <0 0x10201000 0 0x1000>;
	};

	infracfg@1020e000 {
		compatible = "mediatek,infracfg";
		reg = <0 0x1020e000 0 0x1000>;
	};

	hwv: syscon@1031c000 {
		compatible = "mediatek,mt6895-hwv", "syscon";
		reg = <0 0x1031c000 0 0x2000>;
	};

	imp_iic_wrap: syscon@11000000 {
		compatible = "mediatek,mt6990-imp_iic_top_wrap", "syscon";
		reg = <0 0x11000000 0 0x1000>;
		#clock-cells = <1>;
	};

	uart0: serial@11002000 {
		compatible = "mediatek,mt6873-uart", "mediatek,mt6577-uart";
		reg = <0 0x11002000 0 0x1000>;
		interrupts = <GIC_SPI 232 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk26m>, <&pericfg_ao CLK_PERAO_UART0>;
		clock-names = "baud", "bus";
		dmas = <&apdma 0>, <&apdma 1>;
		dma-names = "tx", "rx";
		status = "disabled";
	};

	uart1: serial@11003000 {
		compatible = "mediatek,mt6873-uart", "mediatek,mt6577-uart";
		reg = <0 0x11003000 0 0x1000>, <0 0x11036b90 0 0x20>;
		interrupts = <GIC_SPI 233 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk26m>, <&pericfg_ao CLK_PERAO_UART1>;
		clock-names = "baud", "bus";
		dmas = <&apdma 2>, <&apdma 3>;
		dma-names = "tx", "rx";
		status = "disabled";
	};

	uart2: serial@11004000 {
		compatible = "mediatek,mt6873-uart", "mediatek,mt6577-uart";
		reg = <0 0x11004000 0 0x1000>;
		interrupts = <GIC_SPI 234 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk26m>, <&pericfg_ao CLK_PERAO_UART2>;
		clock-names = "baud", "bus";
		dmas = <&apdma 4>, <&apdma 5>;
		dma-names = "tx", "rx";
		status = "disabled";
	};

	lvts: lvts@1100b000 {
		compatible = "mediatek,mt6980-lvts";
		reg = <0 0x1100b000 0 0x1000>, <0 0x1100c000 0 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 264 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 265 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&pericfg_ao CLK_PERAO_PTP_THERM_MCU_BCLK>,
		         <&pericfg_ao CLK_PERAO_PTP_THERM_MCU_SYS>,
		         <&pericfg_ao CLK_PERAO_PTP_THERM_BCLK>,
		         <&pericfg_ao CLK_PERAO_PTP_THERM_SYS>;
		clock-names = "lvts_clk1", "lvts_clk2", "lvts_clk3", "lvts_clk4";
		nvmem-cells = <&lvts_calib0>, <&lvts_calib1>;
		nvmem-cell-names = "e_data1", "e_data2";
		#thermal-sensor-cells = <1>;
	};

	pericfg_ao: syscon@11036000 {
		compatible = "mediatek,mt6990-pericfg_ao", "syscon";
		reg = <0 0x11036000 0 0x1000>;
		#clock-cells = <1>;
	};

	ssusb: usb@11201000 {
		compatible = "mediatek,mtu3";
		reg = <0 0x11201000 0 0x2e00>,
		      <0 0x11203e00 0 0x100>,
		      <0 0x12001000 0 0x1000>,
		      <0 0x11036000 0 0x1000>;
		reg-names = "mac", "ippc", "spm", "pericfg";
		ranges;
		interrupts = <GIC_SPI 274 IRQ_TYPE_LEVEL_HIGH>;
		phys = <&u2port0 3>, <&u3port0 4>;
		clocks = <&pericfg_ao CLK_PERAO_USB_SYS>, <&pericfg_ao CLK_PERAO_USB_XCHI>;
		clock-names = "sys_ck", "ref_ck";
		maximum-speed = "super-speed-plus";
		power-domains = <&scpsys MT6990_POWER_DOMAIN_SSUSB_TOP>;
		#address-cells = <2>;
		#size-cells = <2>;
		mediatek,usb3-drd;
		mediatek,gen1-txdeemph;
		status = "disabled";

		xhci: usb@11200000 {
			compatible = "mediatek,mtk-xhci";
			reg = <0 0x11200000 0 0x1000>;
			reg-names = "mac";
			interrupts = <GIC_SPI 275 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk26m>;
			clock-names = "sys_ck";
		};
	};

	ssusb_ippc: syscon@11203e00 {
		compatible = "mediatek,mt6990-ssusb", "syscon";
		reg = <0 0x11203e00 0 0x1000>;
		#clock-cells = <1>;
	};

	msdc0_cfg: syscon@11230000 {
		compatible = "mediatek,mt6990-msdc0", "syscon";
		reg = <0 0x11230000 0 0x1000>;
		#clock-cells = <1>;
	};

	mmc0: mmc@11230000 {
		compatible = "mediatek,mt6990-mmc";
		reg = <0 0x11230000 0 0x1000>, <0 0x11f00000 0 0x1000>;
		interrupts = <GIC_SPI 260 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&pericfg_ao CLK_PERAO_MSDC50_SCAN>,
		         <&pericfg_ao CLK_PERAO_MSDC50_HCLK>,
		         <&pericfg_ao CLK_PERAO_MSDC0_AXI_MASTER>,
		         <&pericfg_ao CLK_PERAO_MSDC0_AHB_SLAVE>;
		clock-names = "source", "hclk", "axi_cg", "ahb_cg";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	msdc1_cfg: syscon@11240000 {
		compatible = "mediatek,mt6990-msdc1", "syscon";
		reg = <0 0x11240000 0 0x1000>;
		#clock-cells = <1>;
	};

	pcie0: pcie@11280000 {
		compatible = "mediatek,mt6990-pcie";
		reg = <0 0x11280000 0 0x2000>;
		reg-names = "pcie-mac";
		ranges = <0x82000000 0 0x30000000 0 0x30000000 0 0x10000000>;
		interrupts = <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH>;
		bus-range = <0 255>;
		phys = <&pcie_phy0>;
		phy-names = "pcie-phy";
		clocks = <&pericfg_ao CLK_PERAO_PERI2PCIE0__TX>,
		         <&vlpcfg CLK_VLPCFG_PCIE_TL_32K>,
		         <&vlpcfg CLK_VLPCFG_PCIE_TL_26M>,
		         <&vlpcfg CLK_VLPCFG_PCIE_TL_96M>,
		         <&vlpcfg CLK_VLPCFG_PCIE_TL_ULPOSC>,
		         <&vlpcfg CLK_VLPCFG_PCIE_REF_CK_26M>,
		         <&vlpcfg CLK_VLPCFG_PCIE_AXI250>,
		         <&vlpcfg CLK_VLPCFG_PCIE_SRAM_26M>,
		         <&vlp_cksys CLK_VLP_CK_TL_VLP_SEL>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_PCIE0>;
		interrupt-map-mask = <0 0 0 0x7>;
		interrupt-map = <0 0 0 1 &pcie0_intc 0>,
		                <0 0 0 2 &pcie0_intc 1>,
		                <0 0 0 3 &pcie0_intc 2>,
		                <0 0 0 4 &pcie0_intc 3>;
		#address-cells = <3>;
		#size-cells = <2>;
		#interrupt-cells = <1>;
		linux,pci-domain = <0>;
		status = "disabled";

		pcie0_intc: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

	pcie1: pcie@11288000 {
		compatible = "mediatek,mt6990-pcie";
		reg = <0 0x11288000 0 0x2000>;
		reg-names = "pcie-mac";
		ranges = <0x82000000 0 0x40000000 0 0x40000000 0 0x4000000>;
		interrupts = <GIC_SPI 278 IRQ_TYPE_LEVEL_HIGH>;
		bus-range = <0 255>;
		phys = <&pcie_phy1>;
		phy-names = "pcie-phy";
		clocks = <&pericfg_ao CLK_PERAO_PCIE_2LX1_TL>,
		         <&pericfg_ao CLK_PERAO_PCIE_2LX1_REF>,
		         <&pericfg_ao CLK_PERAO_PCIE_2LX1_AXI>,
		         <&pericfg_ao CLK_PERAO_PCIE_2LX1_AHB>,
		         <&pericfg_ao CLK_PERAO_PCIE_2LX1_26M>,
		         <&topckgen CLK_TOP_TL_SEL>,
		         <&topckgen CLK_TOP_PCIE_250M_SEL>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_PCIE1>;
		interrupt-map-mask = <0 0 0 0x7>;
		interrupt-map = <0 0 0 1 &pcie1_intc 0>,
		                <0 0 0 2 &pcie1_intc 1>,
		                <0 0 0 3 &pcie1_intc 2>,
		                <0 0 0 4 &pcie1_intc 3>;
		#address-cells = <3>;
		#size-cells = <2>;
		#interrupt-cells = <1>;
		linux,pci-domain = <1>;
		status = "disabled";

		pcie1_intc: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

	pcie2: pcie@11290000 {
		compatible = "mediatek,mt6990-pcie";
		reg = <0 0x11290000 0 0x2000>;
		reg-names = "pcie-mac";
		ranges = <0x82000000 0 0x44000000 0 0x44000000 0 0x4000000>;
		interrupts = <GIC_SPI 279 IRQ_TYPE_LEVEL_HIGH>;
		bus-range = <0 255>;
		phys = <&pcie_phy2>;
		phy-names = "pcie-phy";
		clocks = <&pericfg_ao CLK_PERAO_PCIE_2LX2_TL>,
		         <&pericfg_ao CLK_PERAO_PCIE_2LX2_REF>,
		         <&pericfg_ao CLK_PERAO_PCIE_2LX2_AXI>,
		         <&pericfg_ao CLK_PERAO_PCIE_2LX2_AHB>,
		         <&pericfg_ao CLK_PERAO_PCIE_2LX2_26M>,
		         <&topckgen CLK_TOP_TL_SEL>,
		         <&topckgen CLK_TOP_PCIE_250M_SEL>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_PCIE2>;
		interrupt-map-mask = <0 0 0 0x7>;
		interrupt-map = <0 0 0 1 &pcie2_intc 0>,
		                <0 0 0 2 &pcie2_intc 1>,
		                <0 0 0 3 &pcie2_intc 2>,
		                <0 0 0 4 &pcie2_intc 3>;
		#address-cells = <3>;
		#size-cells = <2>;
		#interrupt-cells = <1>;
		linux,pci-domain = <2>;
		status = "disabled";

		pcie2_intc: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

	apdma: dma-controller@11300000 {
		compatible = "mediatek,mt6873-uart-dma", "mediatek,mt6577-uart-dma";
		reg = <0 0x11300400 0 0x80>,
		      <0 0x11300480 0 0x80>,
		      <0 0x11300500 0 0x80>,
		      <0 0x11300580 0 0x80>,
		      <0 0x11300600 0 0x80>,
		      <0 0x11300680 0 0x80>;
		interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 246 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 247 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH>;
		dma-requests = <6>;
		dma-bits = <34>;
		clocks = <&clk26m>;
		#dma-cells = <1>;
	};

	sgmiisys0: syscon@11304000 {
		compatible = "mediatek,mt6990-sgmiisys", "mediatek,colgin-sgmiisys_0", "syscon";
		reg = <0 0x11304000 0 0x1000>;
		phys = <&sgmii_phy0>;
		phy-names = "sgmii";
		#clock-cells = <1>;
		mediatek,physpeed = "2500";
	};

	sgmiisys1: syscon@11305000 {
		compatible = "mediatek,mt6990-sgmiisys", "mediatek,colgin-sgmiisys_1", "syscon";
		reg = <0 0x11305000 0 0x1000>;
		phys = <&sgmii_phy1>;
		phy-names = "sgmii";
		#clock-cells = <1>;
		mediatek,physpeed = "2500";
	};

	pcie_phy0: pcie-phy@11310000 {
		compatible = "mediatek,mt6980-pcie-phy";
