	xsphy: xs-phy@11ec0000 {
		compatible = "mediatek,xsphy";
		reg = <0 0x11ec3000 0 0x200>;
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;
		mediatek,mt6990-power-sequence;
		status = "disabled";

		u2port0: usb-phy@11ec0000 {
			reg = <0 0x11ec0000 0 0x400>;
			clocks = <&clk26m>;
			clock-names = "ref";
			nvmem-cells = <&u2_calib>;
			nvmem-cell-names = "u2_efuse_data";
			#phy-cells = <1>;
			mediatek,efuse-u2-intr-cal = <0x23>;
			mediatek,efuse-u2-term-cal = <0x8>;
			mediatek,eye-vrt = <2>;
			mediatek,eye-vrt-host = <2>;
			mediatek,discth = <9>;
			mediatek,rev6 = <1>;
			mediatek,sqth = <5>;
		};

		u3port0: usb-phy@11ec3000 {
			reg = <0 0x11ec3400 0 0x500>;
			clocks = <&clk26m>;
			clock-names = "ref";
			nvmem-cells = <&u3_calib>;
			nvmem-cell-names = "u3_efuse_data";
			#phy-cells = <1>;
		};
	};

	ssusb_phy_cfg: syscon@11ec0300 {
		compatible = "mediatek,mt6990-ssusb_phy", "syscon";
		reg = <0 0x11ec0300 0 0x1000>;
		#clock-cells = <1>;
	};

	i2c2: i2c@11ed0000 {
		compatible = "mediatek,mt6990-i2c", "mediatek,mt8188-i2c";
		reg = <0 0x11ed0000 0 0x1000>, <0 0x11300180 0 0x80>;
		interrupts = <GIC_SPI 370 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&imp_iic_wrap CLK_IMP_IIC_TOP_WRAP_I2C2>, <&pericfg_ao CLK_PERAO_AP_DMA_HCLK>;
		clock-names = "main", "dma";
		clock-div = <1>;
		clock-frequency = <400000>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	i2c3: i2c@11ed1000 {
		compatible = "mediatek,mt6990-i2c", "mediatek,mt8188-i2c";
		reg = <0 0x11ed1000 0 0x1000>, <0 0x11300200 0 0x80>;
		interrupts = <GIC_SPI 371 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&imp_iic_wrap CLK_IMP_IIC_TOP_WRAP_I2C3>, <&pericfg_ao CLK_PERAO_AP_DMA_HCLK>;
		clock-names = "main", "dma";
		clock-div = <1>;
		clock-frequency = <400000>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	scpsys: power-controller@12001000 {
		compatible = "mediatek,mt6990-scpsys", "syscon";
		reg = <0 0x12001000 0 0x1000>;
		infracfg = <&infracfg_ao>;
		vlpcfg = <&vlp_cksys>;
		pericfg = <&pericfg_ao>;
		clocks = <&topckgen CLK_TOP_MM_SEL>,
		         <&topckgen CLK_TOP_NETSYS_SEL>,
		         <&topckgen CLK_TOP_NETSYS_WED_MCU_SEL>,
		         <&topckgen CLK_TOP_NETSYS_MED_MCU_SEL>,
		         <&topckgen CLK_TOP_NETSYS_500M_SEL>,
		         <&topckgen CLK_TOP_NETSYS_2X_SEL>,
		         <&mdpsys CLK_MDP_SMI_COMMON>,
		         <&topckgen CLK_TOP_ETH_312P5M_SEL>,
		         <&topckgen CLK_TOP_SNPS_ETH_250M_SEL>,
		         <&topckgen CLK_TOP_SNPS_ETH_62P4M_PTP_SEL>,
		         <&topckgen CLK_TOP_SNPS_ETH_50M_RMII_SEL>,
		         <&vlpcfg CLK_VLPCFG_PCIE_SRAM_26M>;
		clock-names = "disp",
		              "netsys",
		              "wedsys",
		              "medsys",
		              "net500",
		              "net2x",
		              "disp-0",
		              "eth1",
		              "eth2",
		              "eth3",
		              "eth4",
		              "pcie0";
		#power-domain-cells = <1>;
	};

	watchdog: watchdog@12007000 {
		compatible = "mediatek,mt6880-wdt", "mediatek,mt6589-wdt", "syscon", "simple-mfd";
		reg = <0 0x12007000 0 0x1000>;
	};

	vlpcfg: syscon@1200c000 {
		compatible = "mediatek,mt6990-vlpcfg", "syscon";
		reg = <0 0x1200c000 0 0x1000>;
		#clock-cells = <1>;
	};

	sys_timer: timer@12011000 {
		compatible = "mediatek,sys_timer", "mediatek,mt6765-timer";
		reg = <0 0x12011000 0 0x1000>;
		interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk13m>;
	};

	vlp_cksys: syscon@12013000 {
		compatible = "mediatek,mt6990-vlp_cksys", "syscon";
		reg = <0 0x12013000 0 0x1000>;
		#clock-cells = <1>;
	};

	pwm: pwm@12016000 {
		compatible = "mediatek,mt6990-pwm";
		reg = <0 0x12016000 0 0x1000>;
		interrupts = <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&vlp_cksys CLK_VLP_CK_PWM_VLP_SEL>,
		         <&vlpcfg CLK_VLPCFG_PWM_CK_CGEN_8>,
		         <&vlpcfg CLK_VLPCFG_PWM_CK_CGEN_1>,
		         <&vlpcfg CLK_VLPCFG_PWM_CK_CGEN_2>,
		         <&vlpcfg CLK_VLPCFG_PWM_CK_CGEN_3>,
		         <&vlpcfg CLK_VLPCFG_PWM_CK_CGEN_4>,
		         <&vlpcfg CLK_VLPCFG_PWM_CK_CGEN_5>,
		         <&vlpcfg CLK_VLPCFG_PWM_CK_CGEN_6>,
		         <&vlpcfg CLK_VLPCFG_PWM_CK_CGEN_7>;
		clock-names = "top", "main", "pwm1", "pwm2", "pwm3", "pwm4", "pwm5", "pwm6", "pwm7";
		#pwm-cells = <2>;
		status = "disabled";
	};

	spmi: spmi@12804000 {
		compatible = "mediatek,mt6990-spmi";
		reg = <0 0x12804000 0 0x8ff>, <0 0x12806000 0 0x120>;
		reg-names = "pmif", "spmimst";
		interrupts-extended = <&gic GIC_SPI 168 IRQ_TYPE_LEVEL_HIGH>,
		                      <&pio 220 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "pmif_irq", "rcs_irq";
		interrupt-controller;
		irq_event_en = <0x80000000 0 0 0 0>;
		clocks = <&vlp_cksys CLK_VLP_CK_PWRAP_ULPOSC_SEL>,
		         <&vlp_cksys CLK_VLP_CK_SPMI_M_MST_SEL>;
		clock-names = "vlp_pmif_clk_mux", "vlp_spmimst_m_clk_mux";
		swinf_ch_start = <10>;
		ap_swinf_no = <2>;
		grpid = <11>;
		#interrupt-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		mt6361: pmic@4 {
			compatible = "mediatek,mt6361";
			reg = <4 0 11 1>;
			interrupts = <4>;
			interrupt-controller;
			#address-cells = <1>;
			#size-cells = <0>;
			#interrupt-cells = <1>;

			efuse1: efuse {
				compatible = "mediatek,mt6361-efuse";
				#address-cells = <1>;
				#size-cells = <1>;

				t_e: t-e@0 {
					reg = <0 0xc>;
				};
			};

			/* USB ID detection (OTG): not compiled in; no driver for it even in the stock kernel */
#if 0
			extcon_usb_microb {
				compatible = "mediatek,extcon-usb-microb";
				interrupts = <2>;
				interrupt-names = "vdet";
				id-gpio = <&pio 45 GPIO_ACTIVE_HIGH>;
				drvbus-gpio = <&pio 46 GPIO_ACTIVE_HIGH>;
				usb_mode = <0>;

				port {
					extcon_microb_role: endpoint@0 {
						remote-endpoint = <&ssusb_role_microb>;
					};
				};
			};
#endif
		};

		/* Modem (CCCI): not compiled in, see the modem note at the end of this file */
#if 0
		md1_sim1_hot_plug_eint {
			compatible = "mediatek,md1_sim1_hot_plug_eint-eint";
			interrupts = <0 4>;
			debounce = <0 100000>;
			dedicated = <0 0>;
			src_pin = <0 1>;
			sockettype = <0 0>;
			status = "okay";
		};

		md1_sim2_hot_plug_eint {
			compatible = "mediatek,md1_sim2_hot_plug_eint-eint";
			interrupts = <1 8>;
			debounce = <1 100000>;
			dedicated = <1 0>;
			src_pin = <1 2>;
			sockettype = <1 0>;
			status = "okay";
		};

		md1_pmic1_eint {
			compatible = "mediatek,md1_pmic1_eint-eint";
			interrupts = <3 8>;
			debounce = <3 0>;
			dedicated = <3 0>;
			src_pin = <3 3>;
			sockettype = <3 0>;
			status = "okay";
		};

		md_attr {
			compatible = "mediatek,md_attr_node";
			mediatek,md_product_name_model_id = <252645135>;
		};
#endif /* modem */
	};

	mdpsys: syscon@14000000 {
		compatible = "mediatek,mt6990-mdpsys", "syscon";
		reg = <0 0x14000000 0 0x1000>;
		#clock-cells = <1>;
	};

	ethsys: syscon@15000000 {
		compatible = "mediatek,leopard-ethsys", "syscon", "simple-mfd";
		reg = <0 0x15000000 0 0x1000>;
		#address-cells = <1>;
		#size-cells = <1>;
		#clock-cells = <1>;
		#reset-cells = <1>;

		reset_controller: reset-controller {
			compatible = "ti,syscon-reset";
			#reset-cells = <1>;
			ti,reset-bits = <0x34 4 0x34 4 0x34 4 (ASSERT_SET | DEASSERT_CLEAR |
			                 STATUS_SET)>;
		};
	};

	/* The last two interrupts (phy0, phy1) are external PHY lines on GPIO 50 and 52. */
	eth: ethernet@15100000 {
		compatible = "mediatek,mt6990-eth", "syscon";
		reg = <0 0x15100000 0 0x30000>;
		interrupts-extended = <&gic GIC_SPI 407 IRQ_TYPE_LEVEL_HIGH>,
		                      <&gic GIC_SPI 408 IRQ_TYPE_LEVEL_HIGH>,
		                      <&gic GIC_SPI 400 IRQ_TYPE_LEVEL_HIGH>,
		                      <&gic GIC_SPI 401 IRQ_TYPE_LEVEL_HIGH>,
		                      <&gic GIC_SPI 402 IRQ_TYPE_LEVEL_HIGH>,
		                      <&gic GIC_SPI 403 IRQ_TYPE_LEVEL_HIGH>,
		                      <&pio 50 IRQ_TYPE_EDGE_FALLING>,
		                      <&pio 52 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "fe-reserved",
		                  "fe1",
		                  "fe2",
		                  "fe-rx1",
		                  "fe-rx2",
		                  "fe-rx3",
		                  "phy0",
		                  "phy1";
		clocks = <&topckgen CLK_TOP_SGMII_0_SEL>,
		         <&topckgen CLK_TOP_SGMII_SBUS_0_SEL>,
		         <&topckgen CLK_TOP_SGMII_1_SEL>,
		         <&topckgen CLK_TOP_SGMII_SBUS_1_SEL>,
		         <&topckgen CLK_TOP_USXGMII_SBUS_0_SEL>,
		         <&topckgen CLK_TOP_USXGMII_SBUS_1_SEL>;
		clock-names = "sgmii_0_sel",
		              "sgmii_sbus_0_sel",
		              "sgmii_1_sel",
		              "sgmii_sbus_1_sel",
		              "usxgmii_sbus_0_sel",
		              "usxgmii_sbus_1_sel";
		#address-cells = <1>;
		#size-cells = <0>;
		mediatek,infracfg = <&infracfg_ao>;
		mediatek,ethsys = <&ethsys>;
		mediatek,sgmiisys = <&sgmiisys0>, <&sgmiisys1>;
		mediatek,sgmii_pll = <&sgmii_pll>;
		status = "disabled";

		gmac0: mac@0 {
			compatible = "mediatek,eth-mac";
			reg = <0>;
			status = "disabled";
		};

		gmac1: mac@1 {
			compatible = "mediatek,eth-mac";
			reg = <1>;
			status = "disabled";
		};

		mdio: mdio-bus {
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};

	/*
	 * Nodes the bootloader (LK) fills in at boot (memory map, DRAM and EMI
	 * settings, firmware handover). Linux has no driver for them, but LK finds
	 * them by path, so their names and unit addresses are kept exactly as in the
	 * stock tree, even where they do not follow the naming rules (upper-case
	 * gps@18C00000; consys, gps and medmcu unit addresses that differ from their
	 * first reg; sleep@12001000 sharing the address of scpsys).
	 */

	emicen: emicen@10217000 {
		compatible = "mediatek,mt6980-emicen", "mediatek,common-emicen";
		reg = <0 0x10217000 0 0x1000>;
		a2d_hash = <1>;
		a2d_disph = <2>;
		mediatek,emi-reg = <&emichn>;
	};

	emimpu@1021a000 {
		compatible = "mediatek,mt6980-emimpu", "mediatek,common-emimpu";
		reg = <0 0x1021a000 0 0x1000>;
		interrupts = <GIC_SPI 338 IRQ_TYPE_LEVEL_HIGH>;
		region_cnt = <0x20>;
		domain_cnt = <16>;
		addr_align = <0x10>;
		ap_region = <0x1f>;
		ap_apc = <5 5 0 5 0 0 6 5 0 0 5 5 5 5 5 5>;
		dump = <496 504 508>;
		clear = <352 0xffffffff 16 512 3 16 496 0x80000000 1>;
		clear_md = <508 0x80000000 1>;
		ctrl_intf = <0x1>;
		slverr = <0>;
		mediatek,emi-reg = <&emicen>;
	};

	dramc@10230000 {
		compatible = "mediatek,mt6990-dramc", "mediatek,common-dramc";
		reg = <0 0x10230000 0 0x2000>,
		      <0 0x10240000 0 0x2000>,
		      <0 0x10234000 0 0x1000>,
		      <0 0x10244000 0 0x1000>,
		      <0 0x10238000 0 0x2000>,
		      <0 0x10248000 0 0x2000>,
		      <0 0x10236000 0 0x2000>,
		      <0 0x10246000 0 0x2000>,
		      <0 0x10006000 0 0x1000>;
		mr4_version = <1>;
		mr4_rg = <144 65535 0>;
		fmeter_version = <2>;
		crystal_freq = <26>;
		pll_id = <3252 256 8>;
		shu_lv = <3252 0x30000 16>;
		shu_of = <1792>;
		sdmpcw = <2312 0x7fff8 3 2344 0x7fff8 3>;
		prediv = <2316 49152 14 2348 49152 14>;
		posdiv = <2316 14336 11 2348 14336 11>;
		ckdiv4 = <2164 4 2 2164 4 2>;
		pll_md = <1860 256 8 1860 256 8>;
		cldiv2 = <2228 2 1 2228 2 1>;
		fbksel = <0x910 0x20 0x5 0x910 0x20 0x5>;
		dqopen = <3476 0x2000000 25 3476 0x2000000 25>;
		ckdiv4_b0 = <5100 4 2 5100 4 2>;
		ckdiv4_ca = <4972 4 2 4972 4 2>;
	};

	emichn: emichn@10235000 {
		compatible = "mediatek,mt6980-emichn", "mediatek,common-emichn";
		reg = <0 0x10235000 0 0x1000>, <0 0x10245000 0 0x1000>;
	};

	sleep: sleep@12001000 {
		compatible = "mediatek,sleep", "syscon";
		reg = <0 0x12001000 0 0x1000>;
	};

	sspm@12300000 {
		compatible = "mediatek,sspm";
		reg = <0 0x12300000 0 0x28000>,
		      <0 0x12340000 0 0x10000>,
		      <0 0x12350000 0 0x100>,
		      <0 0x12351000 0 0x4>,
		      <0 0x12351004 0 0x4>,
		      <0 0x12360000 0 0x100>,
		      <0 0x12361000 0 0x4>,
		      <0 0x12361004 0 0x4>,
		      <0 0x12370000 0 0x100>,
		      <0 0x12371000 0 0x4>,
		      <0 0x12371004 0 0x4>,
		      <0 0x12380000 0 0x100>,
		      <0 0x12381000 0 0x4>,
		      <0 0x12381004 0 0x4>,
		      <0 0x12390000 0 0x100>,
		      <0 0x12391000 0 0x4>,
		      <0 0x12391004 0 0x4>;
		reg-names = "sspm_base",
		            "cfgreg",
		            "mbox0_base",
		            "mbox0_set",
		            "mbox0_clr",
		            "mbox1_base",
		            "mbox1_set",
		            "mbox1_clr",
		            "mbox2_base",
		            "mbox2_set",
		            "mbox2_clr",
		            "mbox3_base",
		            "mbox3_set",
		            "mbox3_clr",
		            "mbox4_base",
		            "mbox4_set",
		            "mbox4_clr";
		interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 147 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 148 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "ipc", "mbox0", "mbox1", "mbox2", "mbox3", "mbox4";
		sspm_res_ram_start = <0>;
		sspm_res_ram_size = <0x210000>;
	};

	medmcu@15f00000 {
		compatible = "mediatek,medmcu";
		reg = <0 0x15d00000 0 0x20000>,
		      <0 0x15f24000 0 0x1000>,
		      <0 0x15f21000 0 0x1000>,
		      <0 0x15f30000 0 0x1000>,
		      <0 0x15f40000 0 0x1000>,
		      <0 0x15f52000 0 0x1000>,
		      <0 0x15f60000 0 0x40000>,
		      <0 0x15fa5000 0 0x4>,
		      <0 0x15ffb000 0 0x100>,
		      <0 0x15ffb100 0 0x4>,
		      <0 0x15ffb10c 0 0x4>,
		      <0 0x15fa5020 0 0x4>,
		      <0 0x15ffc000 0 0x100>,
		      <0 0x15ffc100 0 0x4>,
		      <0 0x15ffc10c 0 0x4>,
		      <0 0x15fa5024 0 0x4>,
		      <0 0x15ffd000 0 0x100>,
		      <0 0x15ffd100 0 0x4>,
		      <0 0x15ffd10c 0 0x4>,
		      <0 0x15fa5028 0 0x4>,
		      <0 0x15ffe000 0 0x100>,
		      <0 0x15ffe100 0 0x4>,
		      <0 0x15ffe10c 0 0x4>,
		      <0 0x15fa502c 0 0x4>,
		      <0 0x15fff000 0 0x100>,
		      <0 0x15fff100 0 0x4>,
		      <0 0x15fff10c 0 0x4>,
		      <0 0x15fa5030 0 0x4>,
		      <0 0x15b80000 0 0x100>;
		reg-names = "scp_sram_base",
		            "scp_cfgreg",
		            "scp_clkreg",
		            "scp_cfgreg_core0",
		            "scp_cfgreg_core1",
		            "scp_bus_tracker",
		            "scp_l1creg",
		            "scp_cfgreg_sec",
		            "mbox0_base",
		            "mbox0_set",
		            "mbox0_clr",
		            "mbox0_init",
		            "mbox1_base",
		            "mbox1_set",
		            "mbox1_clr",
		            "mbox1_init",
		            "mbox2_base",
		            "mbox2_set",
		            "mbox2_clr",
		            "mbox2_init",
		            "mbox3_base",
		            "mbox3_set",
		            "mbox3_clr",
		            "mbox3_init",
		            "mbox4_base",
		            "mbox4_set",
		            "mbox4_clr",
		            "mbox4_init";
		interrupts = <GIC_SPI 463 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 464 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 465 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 466 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 467 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "mbox0", "mbox1", "mbox2", "mbox3", "mbox4";
		core_0 = "enable";
		scp_sramSize = <0x20000>;
		mbox_count = <5>;
		send_table = <0 0 7 3 1 2 4 1 1 5 1 1 6 1 1 11 2 18 13 2 1 15 3 1 16 3 1 17 3 1 18 3
		              1 19 3 1 20 3 1 21 3 1 22 3 2 23 3 2 24 3 2 31 4 34>;
		recv_table = <1 0 2 0 2 0 20 0 7 1 2 0 8 1 10 0 9 1 1 0 10 1 2 0 5 1 1 1 12 2 2 0 14
		              2 2 0 25 3 2 0 26 3 10 0 27 3 1 0 28 3 5 0 29 3 1 0 30 3 2 0 17 3 1 1
		              32 4 30 0>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_MED>;
		clocks = <&topckgen CLK_TOP_NETSYS_MED_MCU_SEL>;
		clock-names = "medmcu_sel";
		status = "okay";
	};

	consys: consys@18000000 {
		compatible = "mediatek,mt6990-consys-atf";
		reg = <0 0x10001000 0 0xf68>,
		      <0 0x10004000 0 0xa7c>,
		      <0 0x11d20000 0 0xa04>,
		      <0 0x12001000 0 0xfb0>,
		      <0 0x18000000 0 0x470>,
		      <0 0x18001000 0 0x658>,
		      <0 0x18003000 0 0x204>,
		      <0 0x1800e000 0 0x124>,
		      <0 0x18011000 0 0x138>,
		      <0 0x18012000 0 0x98>,
		      <0 0x18020000 0 0x4c>,
		      <0 0x18023000 0 0xe28>,
		      <0 0x1803b000 0 0x18>,
		      <0 0x18040000 0 0x2c>,
		      <0 0x18041000 0 0x140>,
		      <0 0x18042000 0 0x324>,
		      <0 0x1804b000 0 0x414>,
		      <0 0x1804d000 0 0x41c>,
		      <0 0x1804f000 0 0x148>,
		      <0 0x18051000 0 0x1000>,
		      <0 0x18060000 0 0xbf8>,
		      <0 0x18070000 0 0x7004>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_CONN_ON>;
		emi-addr = <0>;
		emi-size = <0>;
		fw-binary-size = <0x80000>;
		fw-data-size = <0>;
		ap-shared-size = <0x78000>;
		ap-no-perm-size = <0>;
		gps-emi-offset = <0x80000>;
		emi-alignment = <0x10000>;
		emi-max-addr = <0xffffffff>;
		radio-support = "gps";
		tcxo_support = "false";
		#thermal-sensor-cells = <0>;
	};

	gps@18C00000 {
		compatible = "mediatek,mt6990-gps";
		reg = <0 0x18000000 0 0x100000>,
		      <0 0x18c00000 0 0x100000>,
		      <0 0x18d00000 0 0x100000>,
		      <0 0x10003304 0 0x4>,
		      <0 0x1001c000 0 0x4>,
		      <0 0x1001c030 0 0x4>;
		reg-names = "conn_infra_base",
		            "conn_gps_base",
		            "conn_dyn_base",
		            "status_dummy_cr",
		            "tia2_gps_on",
		            "tia2_gps_rc_sel";
		interrupts = <GIC_SPI 380 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 381 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 382 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 383 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 384 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 385 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 386 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 387 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 388 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 389 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 390 IRQ_TYPE_LEVEL_HIGH>;
		memory-region = <&gps_reserve_memory>;
		pmic = <&efuse1>;
		emi-addr = <0>;
	};

	emiisu {
		compatible = "mediatek,mt6980-emiisu", "mediatek,common-emiisu";
		ctrl_intf = <0x1>;
	};

	mddriver {
		compatible = "mediatek,mddriver";
		reg = <0 0xd124000 0 0x2000>;
		interrupts = <GIC_SPI 333 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_MD>;
		ccci-infracfg = <&infracfg_ao>;
		mediatek,mdhif_type = <2>;
		mediatek,md_id = <0>;
		mediatek,ap_plat_info = <6990>;
		mediatek,md_generation = <6298>;
		mediatek,offset_epon_md1 = <0x44 0x6>;
		mediatek,cldma_capability = <2>;
		mediatek,power_flow_config = <4>;
		mediatek,srclken_o1 = <0>;
	};

	/*
	 * Modem (CCCI, MD1): described from the stock device tree, not compiled in.
	 * The hardware is present, but this tree has no driver for it yet; remove the
	 * #if 0 when one is added. /mddriver and /medmcu stay compiled because LK
	 * writes the modem memory layout into them.
	 */
#if 0
	dpmaif@10011000 {
		compatible = "mediatek,dpmaif";
		reg = <0 0x10011000 0 0x1000>,
		      <0 0x1022d000 0 0x1000>,
		      <0 0x1022c000 0 0x1000>,
		      <0 0x1022e000 0 0x1000>,
		      <0 0x15b14000 0 0x1000>,
		      <0 0x15b38000 0 0x1000>,
		      <0 0x15b13000 0 0x1000>;
		interrupts = <GIC_SPI 209 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 456 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&infracfg_ao CLK_IFRAO_DPMAIF>,
		         <&infracfg_ao CLK_IFRAO_RG_MMW_DPMAIF26M_CK>;
		clock-names = "infra-dpmaif-clk", "infra-dpmaif-rg-mmw-clk";
		mediatek,dpmaif_capability = <6>;
	};

	dpmaif_ao@10011000 {
		compatible = "mediatek,dpmaif_ao";
		reg = <0 0x10011000 0 0x1000>;
	};

	ap_ccif0@10209000 {
		compatible = "mediatek,ap_ccif0";
		reg = <0 0x10209000 0 0x1000>;
		interrupts = <GIC_SPI 258 IRQ_TYPE_LEVEL_HIGH>;
	};

	ccifdriver@10209000 {
		compatible = "mediatek,ccci_ccif";
		reg = <0 0x10209000 0 0x1000>, <0 0x1020a000 0 0x1000>;
		interrupts = <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 185 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&infracfg_ao CLK_IFRAO_CCIF0>, <&infracfg_ao CLK_IFRAO_CCIF1>;
		clock-names = "infra-ccif0", "infra-ccif1";
		mediatek,sram_size = <0x200>;
	};

	md_ccif0@1020a000 {
		compatible = "mediatek,md_ccif0";
		reg = <0 0x1020a000 0 0x1000>;
	};

	ap_ccif1@1020b000 {
		compatible = "mediatek,ap_ccif1";
		reg = <0 0x1020b000 0 0x1000>;
		interrupts = <GIC_SPI 260 IRQ_TYPE_LEVEL_HIGH>;
	};

	md_ccif1@1020c000 {
		compatible = "mediatek,md_ccif1";
		reg = <0 0x1020c000 0 0x1000>;
	};

	md2md_md2_ccif0@10213000 {
		compatible = "mediatek,md2md_md2_ccif0";
		reg = <0 0x10213000 0 0x1000>;
	};

	infra_dpmaif@1022c000 {
		compatible = "mediatek,infra_dpmaif";
		reg = <0 0x1022c000 0 0x10>;
	};

	ap_ccif2@1023c000 {
		compatible = "mediatek,ap_ccif2";
		reg = <0 0x1023c000 0 0x1000>;
		interrupts = <GIC_SPI 262 IRQ_TYPE_LEVEL_HIGH>;
	};

	md_ccif2@1023d000 {
		compatible = "mediatek,md_ccif2";
		reg = <0 0x1023d000 0 0x1000>;
	};

	ap_ccif3@1023e000 {
		compatible = "mediatek,ap_ccif3";
		reg = <0 0x1023e000 0 0x1000>;
		interrupts = <GIC_SPI 263 IRQ_TYPE_LEVEL_HIGH>;
	};

	md_ccif3@1023f000 {
		compatible = "mediatek,md_ccif3";
		reg = <0 0x1023f000 0 0x1000>;
	};

	ap_ccif4@1024c000 {
		compatible = "mediatek,ap_ccif4";
		reg = <0 0x1024c000 0 0x1000>;
	};

	md_ccif4@1024d000 {
		compatible = "mediatek,md_ccif4";
		reg = <0 0x1024d000 0 0x1000>;
	};

	md_ccif4@1024e000 {
		compatible = "mediatek,md_ccif4";
		reg = <0 0x1024e000 0 0x1000>;
	};

	ap_ccif5@1025c000 {
		compatible = "mediatek,ap_ccif5";
		reg = <0 0x1025c000 0 0x1000>;
	};

	md_ccif5@1025d000 {
		compatible = "mediatek,md_ccif5";
		reg = <0 0x1025d000 0 0x1000>;
	};

	tinsys@10500000 {
		compatible = "mediatek,tinsys";
		reg = <0 0x10500000 0 0>;
	};

	modem_temp_share@12012000 {
		compatible = "mediatek,modem_temp_share";
		reg = <0 0x12012000 0 0x1000>;
	};

	md_rf_ic: md-rf-ic {
		compatible = "mediatek,md-rf";
		#thermal-sensor-cells = <0>;
	};

	mutt {
		compatible = "mediatek,mt6297-md-cooler-mutt";

		mutt_pa1: mutt-pa1 {
			id = <0>;
			#cooling-cells = <2>;
		};

		mutt_pa1_no_ims: mutt-pa1-no-ims {
			id = <0>;
			#cooling-cells = <2>;
		};

		mutt_pa2: mutt-pa2 {
			id = <1>;
			#cooling-cells = <2>;
		};

		mutt_pa2_no_ims: mutt-pa2-no-ims {
			id = <1>;
			#cooling-cells = <2>;
		};
	};

	mutt-cc {
		compatible = "mediatek,md-cooler-mutt_cc";

		mutt-cc1 {
			id = <0>;
			#cooling-cells = <2>;
		};

		mutt-cc2 {
			id = <1>;
			#cooling-cells = <2>;
		};
	};

	ul-control {
		compatible = "mediatek,md-cooler-ul-control";

		ul-control {
			id = <0>;
			#cooling-cells = <2>;
		};
	};

	tx-pwr {
		compatible = "mediatek,md-cooler-tx-pwr";

		tx-pwr-pa1 {
			id = <0>;
			#cooling-cells = <2>;
		};

		tx-pwr-pa2 {
			id = <1>;
			#cooling-cells = <2>;
		};
	};

	scg-off {
		compatible = "mediatek,md-cooler-scg-off";

		scg-off-pa2 {
			id = <1>;
			#cooling-cells = <2>;
		};
	};

	cldma_sys_ap {
		compatible = "mediatek,cldma_sys_ap";
		reg = <0 0x1004a000 0 0x1000>, <0 0x1021e000 0 0x1000>;
		interrupts = <GIC_SPI 285 IRQ_TYPE_LEVEL_HIGH>;
		clock-names = "infra-cldma0-rh";
		mediatek,hif_ids = <1>;
	};
#endif /* modem */
};
