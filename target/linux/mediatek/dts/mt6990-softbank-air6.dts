// SPDX-License-Identifier: GPL-2.0-only
/*
 * SoftBank Air 6 (A775)
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/mt65xx.h>
#include <dt-bindings/thermal/thermal.h>

#include "mt6990.dtsi"

/ {
	model = "SoftBank Air 6 (A775)";
	compatible = "softbank,air6", "mediatek,mt6990";

	aliases {
		led-boot = &led_power_green;
		led-failsafe = &led_power_red;
		led-running = &led_power_green;
		led-upgrade = &led_power_green;
	};

	/*
	 * LK keeps these arguments and appends its own (root=, bootslot=, ...).
	 * clk_ignore_unused and fw_devlink=off keep clocks and probe order as in the
	 * stock firmware; the ramoops region matches /reserved-memory; the
	 * air6_dt_bootargs=1 marker shows that the arguments came from this file.
	 */
	chosen {
		bootargs = "console=tty0 console=ttyS0,115200n1 init=/etc/preinit root=/dev/mmcblk0p39 rootwait loglevel=8 androidboot.selinux=permissive androidboot.hardware=mt6990 mtk_printk_ctrl.disable_uart=0 clk_ignore_unused fw_devlink=off deferred_probe_timeout=10 pci=pcie_bus_safe ramoops.mem_address=0x9c100000 ramoops.mem_size=0xe0000 ramoops.record_size=0x1000 ramoops.pmsg_size=0x10000 ramoops.console_size=0x40000 ramoops.ftrace_size=0x1000 air6_dt_bootargs=1";
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		button-reset {
			label = "RESET_KEY";
			gpios = <&pio 29 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
			linux,code = <KEY_RESTART>;
		};

		button-wps {
			label = "WPS_KEY";
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		button-level {
			label = "LEVEL_KEY";
			gpios = <&pio 28 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
			linux,code = <BTN_0>;
		};
	};

	/*
	 * Ethernet jack LEDs on SoC GPIOs. The labels are the names that
	 * board.d/01_leds uses; the 5g_evb_* LEDs come from the stock device tree.
	 */
	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "led1_ethlan1";
			gpios = <&pio 196 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-1 {
			label = "5g_evb_sim";
			gpios = <&pio 18 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-2 {
			label = "5g_evb_system";
			gpios = <&pio 16 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-3 {
			label = "led0_ethlan2";
			gpios = <&pio 197 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-4 {
			label = "led1_ethlan2";
			gpios = <&pio 199 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-5 {
			label = "led0_ethlan1";
			gpios = <&pio 198 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* LK replaces reg with the size of the installed DRAM. */
	memory {
		reg = <0 0x80000000 0 0x3e605000>;
		device_type = "memory";
	};

	regulator_emmc_vcc: regulator-emmc-vcc {
		compatible = "regulator-fixed";
		regulator-name = "emmc_vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	regulator_emmc_vqmmc: regulator-emmc-vqmmc {
		compatible = "regulator-fixed";
		regulator-name = "emmc_vqmmc";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	regulator_usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 46 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * USB dual-role (OTG) switching as described by the stock tree: not compiled
	 * in. This build runs the port as host only and has no extcon or role-switch
	 * driver. The stock firmware runs the controller with dr_mode = "otg" and
	 * drives the role from GPIO 45 (ID) and 46 (VBUS) in Quectel code; its
	 * extcon_usb takes VBUS from a charger regulator instead of drvbus-gpio.
	 */
#if 0
	extcon_usb {
		compatible = "mediatek,extcon-usb";
		drvbus-gpio = <&pio 46 GPIO_ACTIVE_HIGH>;

		port {
			extcon_usb_role: endpoint@0 {
				remote-endpoint = <&ssusb_role_extcon>;
			};
		};
	};
#endif

