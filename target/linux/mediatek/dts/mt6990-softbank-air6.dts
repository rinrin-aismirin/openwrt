	thermal-zones {
		nrpa-ntc-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <1000>;
			thermal-sensors = <&thermal_ntc2>;

			trips {
				nrpa_ntc_trip: nrpa_ntc_trip@0 {
					temperature = <82000>;
					hysteresis = <2000>;
					type = "passive";
				};

				nrpa_ntc_trip_1: nrpa_ntc_trip@1 {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				nrpa_ntc_trip@2 {
					temperature = <100000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&nrpa_ntc_trip>;
					cooling-device = <&mutt_pa2 0 6>;
					#cooling-device = <57 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <&nrpa_ntc_trip_1>;
					cooling-device = <&mutt_pa2_no_ims THERMAL_NO_LIMIT
					                  THERMAL_NO_LIMIT>;
				};
			};
		};

		ltepa-ntc-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <1000>;
			thermal-sensors = <&thermal_ntc3>;

			trips {
				ltepa_ntc_trip: ltepa_ntc_trip@0 {
					temperature = <82000>;
					hysteresis = <2000>;
					type = "passive";
				};

				ltepa_ntc_trip_1: ltepa_ntc_trip@1 {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				ltepa_ntc_trip@2 {
					temperature = <100000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&ltepa_ntc_trip>;
					cooling-device = <&mutt_pa1 0 6>;
					#cooling-device = <62 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <&ltepa_ntc_trip_1>;
					cooling-device = <&mutt_pa1_no_ims THERMAL_NO_LIMIT
					                  THERMAL_NO_LIMIT>;
				};
			};
		};

		rf-ntc-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <1000>;
			thermal-sensors = <&thermal_ntc4>;

			trips {
				rf_ntc_crit@0 {
					temperature = <100000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		md-rf-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <1000>;
			thermal-sensors = <&md_rf_ic>;

			trips {
				md_rf_crit@0 {
					temperature = <117000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};
	};
#endif /* modem */
};

&eth {
	pinctrl-names = "eth_gpio_default", "eth_smi_mdio_pinctl", "eth_smi_mdc_pinctl";
	pinctrl-0 = <&mdio_default_pins>;
	pinctrl-1 = <&eth_smi_mdio_pins>;
	pinctrl-2 = <&eth_smi_mdc_pins>;
	status = "okay";
};

&gmac1 {
	phy-mode = "2500base-x";
	status = "okay";

	fixed-link {
		speed = <2500>;
		full-duplex;
		pause;
	};
};

&i2c2 {
	status = "okay";

	/*
	 * Front-panel LEDs. Pins as in the stock firmware: 0-7 = P0_0-P0_7,
	 * 8-14 = P1_0-P1_6. The signal bars are lv1 (red and blue), lv2 and lv3 (blue).
	 */
	led-controller@5b {
		compatible = "awinic,aw9523b-leds";
		reg = <0x5b>;
		reset-gpios = <&pio 11 GPIO_ACTIVE_LOW>;
		#address-cells = <1>;
		#size-cells = <0>;

		led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN;
		};

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_RED>;
			function = "sim";
		};

		led@2 {
			reg = <2>;
			color = <LED_COLOR_ID_GREEN>;
			function = "sim";
		};

		led@3 {
			reg = <3>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_MOBILE;
		};

		led@4 {
			reg = <4>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_MOBILE;
		};

		led@5 {
			reg = <5>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_MOBILE;
		};

		led@6 {
			reg = <6>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
		};

		led@7 {
			reg = <7>;
			color = <LED_COLOR_ID_RED>;
			function = "signal";
			function-enumerator = <1>;
		};

		led_power_red: led@8 {
			reg = <8>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
		};

		led_power_green: led@9 {
			reg = <9>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
		};

		led@a {
			reg = <10>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WLAN;
		};

		led@b {
			reg = <11>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
		};

		led@c {
			reg = <12>;
			color = <LED_COLOR_ID_BLUE>;
			function = "signal";
			function-enumerator = <1>;
		};

		led@d {
			reg = <13>;
			color = <LED_COLOR_ID_BLUE>;
			function = "signal";
			function-enumerator = <2>;
		};

		led@e {
			reg = <14>;
			color = <LED_COLOR_ID_BLUE>;
			function = "signal";
			function-enumerator = <3>;
		};
	};
};

&mdio {
	switch: switch@1f {
		compatible = "mediatek,mt7531";
		reg = <0x1f>;
		reset-gpios = <&pio 53 GPIO_ACTIVE_HIGH>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;
				label = "lan";
			};

			port@2 {
				reg = <2>;
				label = "wan";
			};

			port@5 {
				reg = <5>;
				ethernet = <&gmac1>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
					pause;
				};
			};
		};
	};
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_default_pins>;
	pinctrl-1 = <&mmc0_uhs_pins>;
	vmmc-supply = <&regulator_emmc_vcc>;
	vqmmc-supply = <&regulator_emmc_vqmmc>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	cap-mmc-hw-reset;
	hs400-ds-delay = <75796>;
	supports-cqe;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		block {
			compatible = "block-device";

			partitions {
				block-partition-raw1 {
					partname = "raw1";

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						eeprom: eeprom@100000 {
							reg = <0x100000 0x1e00>;
						};
					};
				};
			};
		};
	};
};

&pcie0 {
	pinctrl-names = "default", "idle", "sleep";
	pinctrl-0 = <&pcie0_default_pins>;
	pinctrl-1 = <&pcie0_idle_pins>;
	pinctrl-2 = <&pcie0_sleep_pins>;
	status = "okay";

	pcie@0,0 {
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0 0 0 0 0>;
			nvmem-cells = <&eeprom>;
			nvmem-cell-names = "eeprom";
		};
	};
};

&pcie1 {
	pinctrl-names = "default", "idle", "sleep";
	pinctrl-0 = <&pcie1_default_pins>;
	pinctrl-1 = <&pcie1_idle_pins>;
	pinctrl-2 = <&pcie1_sleep_pins>;
	status = "okay";
};

&pcie2 {
	pinctrl-names = "default", "idle", "sleep";
	pinctrl-0 = <&pcie2_default_pins>;
	pinctrl-1 = <&pcie2_idle_pins>;
	pinctrl-2 = <&pcie2_sleep_pins>;
	status = "okay";
};

&pcie_phy0 {
	status = "okay";
};

&pcie_phy1 {
	status = "okay";
};

&pcie_phy2 {
	status = "okay";
};

&pio {
	mmc0_default_pins: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <(MTK_PIN_NO(210) | 1)>,
			         <(MTK_PIN_NO(209) | 1)>,
			         <(MTK_PIN_NO(208) | 1)>,
			         <(MTK_PIN_NO(207) | 1)>,
			         <(MTK_PIN_NO(203) | 1)>,
			         <(MTK_PIN_NO(202) | 1)>,
			         <(MTK_PIN_NO(201) | 1)>,
			         <(MTK_PIN_NO(200) | 1)>,
			         <(MTK_PIN_NO(205) | 1)>;
			input-enable;
			mediatek,pull-up-adv = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <(MTK_PIN_NO(206) | 1)>;
			mediatek,pull-down-adv = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <(MTK_PIN_NO(204) | 1)>;
			mediatek,pull-up-adv = <MTK_PUPD_SET_R1R0_00>;
		};
	};

	mmc0_uhs_pins: mmc0-uhs-pins {
		pins-cmd-dat {
			pinmux = <(MTK_PIN_NO(210) | 1)>,
			         <(MTK_PIN_NO(209) | 1)>,
			         <(MTK_PIN_NO(208) | 1)>,
			         <(MTK_PIN_NO(207) | 1)>,
			         <(MTK_PIN_NO(203) | 1)>,
			         <(MTK_PIN_NO(202) | 1)>,
			         <(MTK_PIN_NO(201) | 1)>,
			         <(MTK_PIN_NO(200) | 1)>,
			         <(MTK_PIN_NO(205) | 1)>;
			input-enable;
			drive-strength = <3>;
			mediatek,pull-up-adv = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <(MTK_PIN_NO(206) | 1)>;
			drive-strength = <3>;
			mediatek,pull-down-adv = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-ds {
			pinmux = <(MTK_PIN_NO(211) | 1)>;
			drive-strength = <3>;
			mediatek,pull-down-adv = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <(MTK_PIN_NO(204) | 1)>;
			drive-strength = <3>;
			mediatek,pull-up-adv = <MTK_PUPD_SET_R1R0_00>;
		};
	};

	pcie0_default_pins: pcie0-default-pins {
		mux {
			pinmux = <(MTK_PIN_NO(54) | 1)>,
			         <(MTK_PIN_NO(55) | 1)>,
			         <(MTK_PIN_NO(56) | 1)>;
			drive-strength = <1>;
			bias-pull-up;
		};
	};

	pcie0_idle_pins: pcie0-idle-pins {
		mux {
			pinmux = <(MTK_PIN_NO(54) | 0)>,
			         <(MTK_PIN_NO(55) | 0)>,
			         <(MTK_PIN_NO(56) | 0)>;
			bias-pull-down;
		};
	};

	pcie0_sleep_pins: pcie0-sleep-pins {
		mux {
			pinmux = <(MTK_PIN_NO(54) | 0)>,
			         <(MTK_PIN_NO(55) | 0)>,
			         <(MTK_PIN_NO(56) | 0)>;
			bias-pull-down;
		};
	};

	pcie1_default_pins: pcie1-default-pins {
		mux {
			pinmux = <(MTK_PIN_NO(57) | 1)>,
			         <(MTK_PIN_NO(58) | 1)>,
			         <(MTK_PIN_NO(59) | 1)>;
			drive-strength = <1>;
			bias-pull-up;
		};
	};

	pcie1_idle_pins: pcie1-idle-pins {
		mux {
			pinmux = <(MTK_PIN_NO(57) | 0)>,
			         <(MTK_PIN_NO(58) | 0)>,
			         <(MTK_PIN_NO(59) | 0)>;
			bias-pull-down;
		};
	};

	pcie1_sleep_pins: pcie1-sleep-pins {
		mux {
			pinmux = <(MTK_PIN_NO(57) | 0)>,
			         <(MTK_PIN_NO(58) | 0)>,
			         <(MTK_PIN_NO(59) | 0)>;
			bias-pull-down;
		};
	};

	pcie2_default_pins: pcie2-default-pins {
		mux {
			pinmux = <(MTK_PIN_NO(60) | 1)>,
			         <(MTK_PIN_NO(61) | 1)>,
			         <(MTK_PIN_NO(62) | 1)>;
			drive-strength = <1>;
			bias-pull-up;
		};
	};

	pcie2_idle_pins: pcie2-idle-pins {
		mux {
			pinmux = <(MTK_PIN_NO(60) | 0)>,
			         <(MTK_PIN_NO(61) | 0)>,
			         <(MTK_PIN_NO(62) | 0)>;
			bias-pull-down;
		};
	};

	pcie2_sleep_pins: pcie2-sleep-pins {
		mux {
			pinmux = <(MTK_PIN_NO(60) | 0)>,
			         <(MTK_PIN_NO(61) | 0)>,
			         <(MTK_PIN_NO(62) | 0)>;
			bias-pull-down;
		};
	};

	mdio_default_pins: mdio-default-pins {
		mux {
			pinmux = <(MTK_PIN_NO(48) | 0)>;
		};
	};

	eth_smi_mdio_pins: eth-smi-mdio-pins {
		mux {
			pinmux = <(MTK_PIN_NO(48) | 1)>;
		};
	};

	eth_smi_mdc_pins: eth-smi-mdc-pins {
		mux {
			pinmux = <(MTK_PIN_NO(49) | 1)>;
		};
	};

	usb_sw_pins: usb-sw-pins {
		pins-cmd-dat {
			pinmux = <(MTK_PIN_NO(100) | 0)>;
			output-low;
		};
	};
};

&ssusb {
	dr_mode = "host";
	pinctrl-names = "default";
	pinctrl-0 = <&usb_sw_pins>;
	status = "okay";
	/* USB dual-role (OTG): not compiled in, see the note at /extcon_usb */
#if 0
	usb-role-switch;
#endif

	/* USB dual-role (OTG): not compiled in, see the note at /extcon_usb */
#if 0
	port {
		ssusb_role_extcon: endpoint@0 {
			remote-endpoint = <&extcon_usb_role>;
		};

		ssusb_role_microb: endpoint@1 {
			remote-endpoint = <&extcon_microb_role>;
		};
	};
#endif
};

&uart0 {
	status = "okay";
};

&xhci {
	vbus-supply = <&regulator_usb_vbus>;
};

&xsphy {
	status = "okay";
};
